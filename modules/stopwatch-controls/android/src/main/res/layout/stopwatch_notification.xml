<?xml version="1.0" encoding="utf-8"?>
<!-- Vista contraída (la que suele verse en la pantalla de bloqueo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Estado ("En marcha"/"En pausa") o, durante el descanso, "Descanso" + cuenta atrás. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stopwatch_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

            <Chronometer
                android:id="@+id/stopwatch_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF0A84FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/stopwatch_chrono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="22sp" />

        <!-- Progreso de series ("2/4") en lugar del cronómetro cuando este no se usa. -->
        <TextView
            android:id="@+id/stopwatch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="22sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/stopwatch_rest_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_sw_blue_dim"
        android:contentDescription="Descanso"
        android:padding="11dp"
        android:src="@drawable/ic_sw_rest" />

    <ImageView
        android:id="@+id/stopwatch_reset"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_sw_gray"
        android:contentDescription="Reiniciar"
        android:padding="11dp"
        android:src="@drawable/ic_sw_reset" />

    <ImageView
        android:id="@+id/stopwatch_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_sw_green"
        android:contentDescription="Iniciar o pausar"
        android:padding="10dp"
        android:src="@drawable/ic_sw_play" />
</LinearLayout>
